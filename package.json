{
  "name": "zustand-store-addons",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Luis Silva",
  "description": "Computed properties, watchers, middleware chaining and more for Zustand stores",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "react",
    "state",
    "manager",
    "management",
    "store",
    "zustand",
    "computed",
    "watcher",
    "middleware"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "react": ">=17",
    "use-sync-external-store": ">=1.2.0",
    "zustand": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "use-sync-external-store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/use-sync-external-store": "^1.5.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "zustand": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Diablow/zustand-store-addons.git"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
